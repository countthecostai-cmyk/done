# Supabase (Project Settings -> API) — SAME project as the Doer and Done Admin
# apps. All three share one Supabase backend; there is no per-app database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — this app (Done, the customer app) is the only one of the three
# that creates Checkout Sessions and owns the /api/stripe/webhook endpoint.
# Register the webhook in the Stripe dashboard pointing at
# <this app's deployed URL>/api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site URL (no trailing slash) — used for Stripe redirect/return URLs
# and Supabase email confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployed URL of the Doer app — used for the "Become a Doer" link.
NEXT_PUBLIC_DOER_APP_URL=
